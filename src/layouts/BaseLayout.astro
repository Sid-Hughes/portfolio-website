---
import { ClientRouter } from 'astro:transitions';
import { getAbout, getSettings } from '../lib/content';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/ThemeScript.astro';
import SmoothScroll from '../components/motion/SmoothScroll.astro';
import RevealStagger from '../components/motion/RevealStagger.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const settings = await getSettings();
const about = await getAbout();
const { title, description = settings.description ?? undefined } = Astro.props;
const pageTitle = title ? `${title} | ${settings.siteTitle}` : settings.siteTitle;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={settings.siteTitle} href="/rss.xml" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-accent px-4 py-2 text-accent-fg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Nav siteTitle={settings.siteTitle} links={settings.navLinks} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer text={settings.footerText} socials={about.data.socials} />
    <SmoothScroll />
    <RevealStagger />
  </body>
</html>
