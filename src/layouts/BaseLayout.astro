---
import { getSettings } from '../lib/content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const settings = await getSettings();
const { title, description = settings.description ?? undefined } = Astro.props;
const pageTitle = title ? `${title} | ${settings.siteTitle}` : settings.siteTitle;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={settings.siteTitle} href="/rss.xml" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="flex min-h-screen flex-col font-sans text-neutral-900">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-2">Skip to content</a>
    <header class="border-b border-neutral-200">
      <nav class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 p-4" aria-label="Main">
        <a href="/" class="font-semibold">{settings.siteTitle}</a>
        <ul class="flex flex-wrap gap-4">
          {settings.navLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined} class="hover:underline aria-[current=page]:underline">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" class="mx-auto w-full max-w-4xl flex-1 p-4">
      <slot />
    </main>
    <footer class="border-t border-neutral-200">
      <div class="mx-auto flex max-w-4xl flex-wrap justify-between gap-2 p-4 text-sm text-neutral-600">
        <p>{settings.footerText}</p>
        <a href="/rss.xml" class="hover:underline">RSS</a>
      </div>
    </footer>
  </body>
</html>
