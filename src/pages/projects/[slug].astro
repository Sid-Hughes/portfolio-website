---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Prose from '../../components/Prose.astro';
import Tag from '../../components/Tag.astro';
import Button from '../../components/Button.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ArrowLink from '../../components/motion/ArrowLink.astro';
import CountUpStats from '../../components/motion/CountUpStats.astro';
import MagneticButton from '../../components/motion/MagneticButton.astro';
import ScaleUpCover from '../../components/motion/ScaleUpCover.astro';
import { formatMonth, getPostsForProject, getProjects, statusLabels, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { title, summary, cover, coverAlt, status, tags, links, startDate, endDate, stats } = project.data;
const { Content } = await render(project);
const relatedPosts = await getPostsForProject(project.id);

const linkList = [
  { label: 'View on GitHub', href: links.github },
  { label: 'Live demo', href: links.demo },
  { label: 'More', href: links.other },
].filter((link): link is { label: string; href: string } => !!link.href);

const dates = startDate
  ? `${formatMonth(startDate)} – ${endDate ? formatMonth(endDate) : 'present'}`
  : null;
---

<BaseLayout title={title} description={summary} ogImage={`/og/projects/${project.id}.png`}>
  <article>
    <header class="container-page pt-16 pb-10 sm:pt-24">
      <ArrowLink href="/projects" direction="back" class="text-sm text-muted hover:text-fg">All projects</ArrowLink>
      <p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-medium uppercase tracking-widest text-accent">
        <span>{statusLabels[status]}</span>
        {dates && <span class="text-muted">{dates}</span>}
      </p>
      <h1 class="mt-4 max-w-4xl text-h1 font-semibold">{title}</h1>
      <p class="mt-5 max-w-2xl text-lead text-muted">{summary}</p>
      {tags.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tags">
          {tags.map((tag) => <li><Tag href={`/projects?tag=${encodeURIComponent(tag)}`}>{tag}</Tag></li>)}
        </ul>
      )}
      {linkList.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-3">
          {linkList.map((link, i) => (
            <MagneticButton>
              <Button href={link.href} variant={i === 0 ? 'primary' : 'secondary'} rel="noopener">
                {link.label} <span aria-hidden="true">↗</span>
              </Button>
            </MagneticButton>
          ))}
        </div>
      )}
    </header>

    <div class="container-page">
      <ScaleUpCover>
        <Image
          src={cover}
          alt={coverAlt}
          widths={[640, 1280, 1920]}
          sizes="(min-width: 1152px) 1088px, 100vw"
          class="w-full"
          loading="eager"
        />
      </ScaleUpCover>
    </div>

    {stats.length > 0 && (
      <div class="container-page mt-12">
        <CountUpStats stats={stats} />
      </div>
    )}

    <div class="container-page py-16">
      <Prose class="mx-auto"><Content /></Prose>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="section-space border-t border-border" aria-labelledby="related-posts">
      <div class="container-page">
        <SectionHeading id="related-posts" eyebrow="Blog" title="Posts about this project" />
        <div class="border-b border-border" data-reveal>
          {relatedPosts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
