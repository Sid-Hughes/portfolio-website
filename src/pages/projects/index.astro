---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { getProjects, getSettings, statusLabels, uniqueTags } from '../../lib/content';

const settings = await getSettings();
const projects = await getProjects();
const statuses = Object.entries(statusLabels)
  .filter(([value]) => projects.some((project) => project.data.status === value))
  .map(([value, label]) => ({ value, label }));
---

<BaseLayout title="Projects" description={settings.projectsIntro ?? undefined}>
  <PageHeader title="Projects" lead={settings.projectsIntro} />
  <div class="container-page pb-24">
    <FilterBar tags={uniqueTags(projects)} statuses={statuses} />
    <div data-filter-list class="grid gap-6 md:grid-cols-2" data-reveal>
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    {projects.length === 0 && <p class="text-muted">No projects yet.</p>}
  </div>
</BaseLayout>
