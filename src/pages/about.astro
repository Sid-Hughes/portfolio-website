---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAbout } from '../lib/content';

const about = await getAbout();
const { name, role, shortBio, headshot, headshotAlt, cvLink, skills, socials } = about.data;
const { Content } = await render(about);
---

<BaseLayout title="About" description={shortBio}>
  <section class="flex flex-col gap-8 py-8 sm:flex-row sm:items-start">
    {headshot && (
      <Image src={headshot} alt={headshotAlt ?? ''} width={240} height={240} class="h-40 w-40 rounded-full object-cover sm:h-60 sm:w-60" />
    )}
    <div>
      <h1 class="text-3xl font-bold">{name}</h1>
      {role && <p class="mt-1 text-lg text-neutral-600">{role}</p>}
      <div class="prose mt-6 max-w-none">
        <Content />
      </div>
      {cvLink && <p class="mt-6"><a href={cvLink} class="underline">Download my CV</a></p>}
    </div>
  </section>

  {skills.length > 0 && (
    <section class="py-8" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="mb-4 text-2xl font-semibold">Skills</h2>
      <ul class="flex flex-wrap gap-2">
        {skills.map((skill) => <li class="rounded bg-neutral-100 px-3 py-1">{skill}</li>)}
      </ul>
    </section>
  )}

  {socials.length > 0 && (
    <section class="py-8" id="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="mb-4 text-2xl font-semibold">Get in touch</h2>
      <ul class="flex flex-wrap gap-4">
        {socials.map((social) => <li><a href={social.url} class="underline" rel="me noopener">{social.label}</a></li>)}
      </ul>
    </section>
  )}
</BaseLayout>
