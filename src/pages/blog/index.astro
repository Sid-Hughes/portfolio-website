---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { getPosts, getSettings, uniqueTags } from '../../lib/content';

const settings = await getSettings();
const posts = await getPosts();
---

<BaseLayout title="Blog" description={settings.blogIntro ?? undefined}>
  <PageHeader title="Blog" lead={settings.blogIntro} />
  <div class="container-page pb-24">
    <FilterBar tags={uniqueTags(posts)} />
    <div data-filter-list class="border-b border-border">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    {posts.length === 0 && <p class="text-muted">No posts yet.</p>}
  </div>
</BaseLayout>
