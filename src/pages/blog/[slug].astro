---
import { Image } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Prose from '../../components/Prose.astro';
import Tag from '../../components/Tag.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ArrowLink from '../../components/motion/ArrowLink.astro';
import ReadingProgress from '../../components/motion/ReadingProgress.astro';
import { formatDate, getPosts, readingTime, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { title, excerpt, publishedDate, tags, cover, coverAlt, draft, relatedProjects } = post.data;
const { Content, headings } = await render(post);
const projects = await getEntries(relatedProjects);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = toc.length > 1;
---

<BaseLayout title={title} description={excerpt}>
  <ReadingProgress />
  <article data-reading-target>
    <header class="container-page pt-16 pb-10 sm:pt-24">
      <div class="mx-auto max-w-3xl">
        <ArrowLink href="/blog" direction="back" class="text-sm text-muted hover:text-fg">All posts</ArrowLink>
        <p class="mt-8 text-sm text-muted">
          <time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time>
          <span aria-hidden="true"> · </span>{readingTime(post.body)}
          {draft && <span class="ml-2 rounded-full bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent">Draft</span>}
        </p>
        <h1 class="mt-4 text-h1 font-semibold">{title}</h1>
        <p class="mt-5 text-lead text-muted">{excerpt}</p>
        {tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tags">
            {tags.map((tag) => <li><Tag href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</Tag></li>)}
          </ul>
        )}
      </div>
    </header>

    {cover && (
      <div class="container-page">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 1280, 1920]}
          sizes="(min-width: 1152px) 1088px, 100vw"
          class="w-full rounded-card border border-border"
          loading="eager"
        />
      </div>
    )}

    <div class:list={['container-page py-16', showToc && 'lg:grid lg:grid-cols-[1fr_16rem] lg:gap-16']}>
      {showToc && (
        <nav class="mb-12 lg:order-last lg:mb-0" aria-labelledby="toc-heading">
          <div class="rounded-card border border-border p-6 lg:sticky lg:top-24">
            <h2 id="toc-heading" class="font-sans text-xs font-medium uppercase tracking-widest text-muted">Contents</h2>
            <ol class="mt-4 flex flex-col gap-2 text-sm">
              {toc.map((heading) => (
                <li class={heading.depth === 3 ? 'pl-4' : ''}>
                  <a href={`#${heading.slug}`} class="text-muted hover:text-fg">{heading.text}</a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )}
      <Prose class:list={[!showToc && 'mx-auto']}><Content /></Prose>
    </div>
  </article>

  {projects.length > 0 && (
    <section class="section-space border-t border-border" aria-labelledby="related-projects">
      <div class="container-page">
        <SectionHeading id="related-projects" eyebrow="Projects" title="Related projects" />
        <div class="grid gap-6 md:grid-cols-2" data-reveal>
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
