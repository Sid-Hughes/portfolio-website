---
import { Image } from 'astro:assets';
import { statusLabels, type Project } from '../lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, cover, coverAlt, status, tags } = project.data;
---

<article
  class="flex flex-col overflow-hidden rounded border border-neutral-200"
  data-filter-item
  data-tags={JSON.stringify(tags)}
  data-status={status}
>
  <Image src={cover} alt={coverAlt} widths={[400, 800]} sizes="(min-width: 640px) 400px, 100vw" class="aspect-video w-full object-cover" />
  <div class="flex flex-1 flex-col gap-2 p-4">
    <p class="text-xs uppercase tracking-wide text-neutral-500">{statusLabels[status]}</p>
    <h3 class="text-lg font-semibold">
      <a href={`/projects/${project.id}`} class="hover:underline">{title}</a>
    </h3>
    <p class="text-neutral-700">{summary}</p>
    {tags.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-2 pt-2 text-xs" aria-label="Tags">
        {tags.map((tag) => <li class="rounded bg-neutral-100 px-2 py-1">{tag}</li>)}
      </ul>
    )}
  </div>
</article>
