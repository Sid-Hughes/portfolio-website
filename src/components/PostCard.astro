---
import Tag from './Tag.astro';
import { formatDate, readingTime, type Post } from '../lib/content';

interface Props {
  post: Post;
  /** Heading level for the title: h2 on list pages, h3 under a section heading. */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const { title, excerpt, publishedDate, tags, draft } = post.data;
---

<article
  class="group relative grid gap-2 border-t border-border py-8 sm:grid-cols-[10rem_1fr] sm:gap-8"
  data-filter-item
  data-tags={JSON.stringify(tags)}
>
  <p class="text-sm text-muted">
    <time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time>
    <span class="sm:block">
      <span class="sm:hidden" aria-hidden="true">·</span>
      {readingTime(post.body)}
    </span>
  </p>
  <div class="flex flex-col gap-2">
    <Heading class="text-h3 font-semibold">
      <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 group-hover:text-accent">{title}</a>
      {draft && <span class="ml-2 rounded-full bg-accent-soft px-2 py-0.5 align-middle font-sans text-xs font-medium text-accent">Draft</span>}
    </Heading>
    <p class="max-w-prose text-muted">{excerpt}</p>
    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 pt-2" aria-label="Tags">
        {tags.map((tag) => <li><Tag>{tag}</Tag></li>)}
      </ul>
    )}
  </div>
</article>
