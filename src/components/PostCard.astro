---
import { formatDate, readingTime, type Post } from '../lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, excerpt, publishedDate, tags, draft } = post.data;
---

<article class="flex flex-col gap-1 border-b border-neutral-200 py-4" data-filter-item data-tags={JSON.stringify(tags)}>
  <p class="text-sm text-neutral-500">
    <time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time>
    · {readingTime(post.body)}
    {draft && <span class="ml-2 rounded bg-amber-100 px-2 text-amber-900">Draft</span>}
  </p>
  <h3 class="text-lg font-semibold">
    <a href={`/blog/${post.id}`} class="hover:underline">{title}</a>
  </h3>
  <p class="text-neutral-700">{excerpt}</p>
  {tags.length > 0 && (
    <ul class="flex flex-wrap gap-2 pt-1 text-xs" aria-label="Tags">
      {tags.map((tag) => <li class="rounded bg-neutral-100 px-2 py-1">{tag}</li>)}
    </ul>
  )}
</article>
