---
import ThemeToggle from './ThemeToggle.astro';
import TextRollLink from './motion/TextRollLink.astro';

interface Props {
  siteTitle: string;
  links: { label: string; href: string }[];
}

const { siteTitle, links } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur">
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="font-display text-lg font-semibold tracking-tight">{siteTitle}</a>
    <div class="flex items-center gap-1 sm:gap-4">
      <ul class="flex items-center gap-1 sm:gap-2">
        {links.map((link) => (
          <li>
            <TextRollLink
              href={link.href}
              label={link.label}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class="nav-link relative block px-2 py-2 text-sm text-muted hover:text-fg aria-[current=page]:text-fg sm:px-3"
            />
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  /* Animated underline: grows from the left on hover, stays full on the current page. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  @media (max-width: 639px) {
    .nav-link::after {
      left: 0.5rem;
      right: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>
