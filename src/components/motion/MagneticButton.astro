---
// Wraps a call-to-action so it drifts toward the cursor and springs back on leave.
// Fine pointers only; static under reduced motion or on touch.
---

<span data-magnetic class="inline-block">
  <slot />
</span>

<script>
  import { gsap } from '../../lib/gsap';
  import { hasFinePointer, onPageLoad, prefersReducedMotion } from '../../lib/lifecycle';

  const PULL_X = 0.35;
  const PULL_Y = 0.5;

  onPageLoad(() => {
    if (prefersReducedMotion() || !hasFinePointer()) return;
    const removers: (() => void)[] = [];

    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      // quickTo setters are created per hover. The spring-back on leave overwrites (kills) them,
      // so reusing one setter across hovers would leave the button stuck after the first leave.
      let pull: { x: gsap.QuickToFunc; y: gsap.QuickToFunc } | null = null;
      const startPull = () => {
        gsap.killTweensOf(el);
        pull = {
          x: gsap.quickTo(el, 'x', { duration: 0.4, ease: 'power3.out' }),
          y: gsap.quickTo(el, 'y', { duration: 0.4, ease: 'power3.out' }),
        };
      };

      const move = (event: PointerEvent) => {
        if (!pull) startPull();
        // Measure from the button's resting centre, not where it has drifted to.
        const rect = el.getBoundingClientRect();
        const centreX = rect.left + rect.width / 2 - Number(gsap.getProperty(el, 'x'));
        const centreY = rect.top + rect.height / 2 - Number(gsap.getProperty(el, 'y'));
        pull!.x((event.clientX - centreX) * PULL_X);
        pull!.y((event.clientY - centreY) * PULL_Y);
      };
      const leave = () => {
        pull = null;
        gsap.to(el, { x: 0, y: 0, duration: 0.9, ease: 'elastic.out(1, 0.4)', overwrite: true });
      };

      el.addEventListener('pointerenter', startPull);
      el.addEventListener('pointermove', move);
      el.addEventListener('pointerleave', leave);
      removers.push(() => {
        el.removeEventListener('pointerenter', startPull);
        el.removeEventListener('pointermove', move);
        el.removeEventListener('pointerleave', leave);
        gsap.killTweensOf(el);
        gsap.set(el, { clearProps: 'transform' });
      });
    });

    return () => removers.forEach((remove) => remove());
  });
</script>
