---
// A line of text whose words fill from faint to full opacity, scrubbed to scroll position.
// Static (fully visible) under reduced motion or without JS.
// Screen readers get the plain sentence; only the visual copy is split into words.
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<p data-word-fill class={className}>
  <span class="sr-only">{text}</span>
  <span aria-hidden="true" data-word-fill-visual>{text}</span>
</p>

<script>
  import { gsap, SplitText } from '../../lib/gsap';
  import { onPageLoad, prefersReducedMotion } from '../../lib/lifecycle';

  onPageLoad(() => {
    if (prefersReducedMotion()) return;
    const ctx = gsap.context(() => {
      document.querySelectorAll<HTMLElement>('[data-word-fill]').forEach((el) => {
        const visual = el.querySelector<HTMLElement>('[data-word-fill-visual]');
        if (!visual) return;
        // autoSplit re-splits after fonts load or on resize, so word boundaries match the final layout.
        SplitText.create(visual, {
          type: 'words',
          aria: 'none',
          autoSplit: true,
          onSplit: (self) =>
            gsap.fromTo(
              self.words,
              { opacity: 0.15 },
              {
                opacity: 1,
                ease: 'none',
                stagger: 0.1,
                scrollTrigger: { trigger: el, start: 'top 85%', end: 'bottom 45%', scrub: true },
              },
            ),
        });
      });
    });
    return () => ctx.revert();
  });
</script>
